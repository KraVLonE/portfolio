# Database (Keep localhost for local dev, Docker overrides this in docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/portfolio

# Security
SECRET_KEY=generate_a_secure_random_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Integrations
GITHUB_TOKEN=your_github_personal_access_token_here
GEMINI_TOKENS=your_comma_separated_gemini_tokens_here

# Email (For Contact Form)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_bot_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL=your_personal_email@gmail.com
